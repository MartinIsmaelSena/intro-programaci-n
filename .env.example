# ==============================================================================
# Python desde Cero - Variables de Entorno de Configuración
# ==============================================================================
#
# 1. INTEGRACIÓN CON GOOGLE SHEETS & NOTIFICACIÓN POR EMAIL (DESAFÍOS):
# Para registrar automáticamente los resultados de los Desafíos en tu hoja de Google Sheets
# y recibir notificaciones por email al completarse:
# - Sigue los pasos de instalación en `google-apps-script/Code.gs`
# - Pega la URL de tu Web App desplegada aquí:
VITE_RESULTS_ENDPOINT=https://script.google.com/macros/s/TU_SCRIPT_ID_AQUI/exec

# 2. EMAIL DEL DOCENTE (Para notificaciones de nuevos desafíos resueltos):
VITE_TEACHER_EMAIL=docente@colegio.edu.ar

# 3. BACKEND EXTERNO (Opcional para futuras versiones):
# VITE_API_BASE_URL=https://api.tudominio.com
